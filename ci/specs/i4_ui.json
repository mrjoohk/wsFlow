{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github"
  ],
  "test": [
    "node",
    "tests/i4_browser.cjs"
  ],
  "timeout": 180,
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "WSFLOW_BROWSER_OUTPUT": "{tmp}/browser-output"
  },
  "mutants": [
    {
      "id": "U01",
      "name": "uncertain offers resend before lookup",
      "edits": [
        {
          "file": "static/index.html",
          "old": "['queued','error'].includes(op.state)",
          "new": "['queued','error','uncertain'].includes(op.state)"
        }
      ]
    },
    {
      "id": "U02",
      "name": "lost approval response discards server IDs",
      "edits": [
        {
          "file": "static/index.html",
          "old": "if(e.status&&e.status<500)GCAL.pending=null;",
          "new": "GCAL.pending=null;"
        }
      ]
    },
    {
      "id": "U03",
      "name": "event private body leaked into date cell",
      "edits": [
        {
          "file": "static/index.html",
          "old": " ${esc(e.title)}</span>",
          "new": " ${esc(e.title)} ${esc(e.body)}</span>"
        }
      ]
    },
    {
      "id": "U04",
      "name": "note editor offers Google target",
      "edits": [
        {
          "file": "static/index.html",
          "old": "${kind==='event'&&!d.id?`<label>저장 대상",
          "new": "${!d.id?`<label>저장 대상"
        }
      ]
    }
  ]
}
