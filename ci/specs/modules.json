      "name": "worker starts before HTTP socket bind succeeds",
      "edits": [
        {
          "file": "wsflow/server.py",
          "old": "    httpd = Server((host, port),",
          "new": "    modules.start_backends()\n    httpd = Server((host, port),"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_builtin_package_update.py",
        "-k",
        "test_occupied_server_port_does_not_start_any_business_module"
      ]
    },
    {
      "id": "PKG_VENDOR",
      "name": "updated generation shares process-flat vendor cache",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/wfhome.py",
          "old": "AGG = _load_vendor('aggregate')\nJF = _load_vendor('jira_fields')",
          "new": "import sys\nsys.path.insert(0, str(VENDOR))\nimport aggregate as AGG\nimport jira_fields as JF"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_package_generation.py",
        "-k",
        "test_vendor_imports"
      ]
    },
    {
