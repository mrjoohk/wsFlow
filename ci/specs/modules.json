{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github",
    "examples"
  ],
  "test": [
    "python",
    "-B",
    "-X",
    "utf8",
    "-c",
    "import unittest; s=unittest.TestSuite(unittest.defaultTestLoader.discover('tests', pattern=p) for p in ['test_module*.py', 'test_builtin_package_update.py', 'test_work_calendar_package.py', 'test_workspace_package.py', 'test_packaged_ui.py', 'test_package_generation.py']); r=unittest.TextTestRunner(verbosity=2).run(s); raise SystemExit(not r.wasSuccessful())"
  ],
  "timeout": 240,
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "mutants": [
    {
      "id": "MOD_STALE",
      "name": "stale module plan replaces newer desired state",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "if current['revision'] != plan['expected_revision']:",
          "new": "if False:"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_two_preview_plans"
      ]
    },
    {
      "id": "MOD_SETTINGS",
      "name": "wrong settings types accepted",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "if not valid or ('enum' in field and value not in field['enum']):",
          "new": "if False:"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_external_configuration_is_validated"
      ]
    },
    {
      "id": "MOD_SOURCE",
      "name": "preview and installed digest pinning both removed",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "if actual != plan['package']:",
          "new": "if False:"
        },
        {
          "file": "wsflow/module_host.py",
          "old": "if inspection['digest'] != record['package_digest']:",
          "new": "if False:"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_package_changed_after_preview"
      ]
    },
    {
      "id": "MOD_ACTIVE_UI",
      "name": "pending UI metadata replaces currently active entry",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "active_ui=copy.deepcopy(active.get('ui', {})) if active else {},",
          "new": "active_ui=copy.deepcopy(record.get('ui', {})),"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_pending_ui_update"
      ]
    },
    {
      "id": "MOD_DISABLE_DAMAGED",
      "name": "cannot disable damaged installed package",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "if record['installed'] and record['enabled']:",
          "new": "if record['installed']:",
          "func": "apply"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_tampered_installed_package"
      ]
    },
    {
      "id": "MOD_OWNER_GATE",
      "name": "legacy module ownership gate removed",
      "edits": [
        {
          "file": "wsflow/server.py",
          "old": "if not modules.builtin_active(owner):",
          "new": "if False:"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_server.py",
        "-k",
        "test_all_disabled_keep_core"
      ]
    },
    {
      "id": "MOD_STOP_LOOKUP",
      "name": "stop lookup exception interrupts other cleanup",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "func": "ModuleHost.close",
          "old": "                try:\n                    stop = getattr(services[ident], 'stop', None)\n                    stopped = not callable(stop) or stop() is not False",
          "new": "                stop = getattr(services[ident], 'stop', None)\n                try:\n                    stopped = not callable(stop) or stop() is not False"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_host.py",
        "-k",
        "test_stop_property_failure"
      ]
    },
    {
      "id": "MOD_STARTUP_ERROR",
      "name": "startup failure reported as disabled instead of unavailable",
      "edits": [
        {
          "file": "wsflow/module_host.py",
          "old": "if ident in self.errors:\n            raise ModuleError('모듈 기동에 실패했습니다: ' + ident, 503)",
          "new": "if False:\n            pass",
          "count": 2
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_module_server.py",
        "-k",
        "test_failed_extension_returns"
      ]
    },
    {
      "id": "PKG_DOMAIN_WORK",
      "name": "upgraded work package reuses canonical workflow implementation",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/backend.py",
          "old": "from . import calendar_store, calendar_sync, google_calendar, jirawrite, newtask, wfhome, workflow",
          "new": "from . import calendar_store, calendar_sync, google_calendar, jirawrite, newtask, wfhome\nfrom wsflow.modules.work_calendar import workflow"
        }
      ],
      "test": [
        "python",
        "-B",
