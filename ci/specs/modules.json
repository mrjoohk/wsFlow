          "file": "wsflow/common_writes.py",
          "old": "if kind=='memo' and memo_adapter is None:",
          "new": "if kind=='memo':"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_builtin_package_update.py",
        "-k",
        "test_memo_save_uses_the_updated_package_adapter_in_common_writes"
