        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_package_generation.py",
        "-k",
        "test_legacy_runtime_unsupported_hook"
      ]
    },
    {
      "id": "PKG_INLINE_DEPS",
      "name": "caller runtime exposes consumer without its declared dependencies",
      "edits": [
        {
          "file": "wsflow/server.py",
          "old": "if any(services.feature(ident) is None for ident in dependencies):",
          "new": "if False:",
          "func": "make_handler"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_package_generation.py",
        "-k",
        "test_legacy_runtime_does_not_expose_consumer"
