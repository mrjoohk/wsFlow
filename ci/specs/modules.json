          "old": " or module_id not in self.module_host.started_backends",
          "new": ""
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_package_generation.py",
        "-k",
        "test_dependency_starts"
      ]
    },
    {
      "id": "PKG_INLINE_RUNTIME",
      "name": "legacy supplied runtime is discarded by handler adapter",
      "edits": [
        {
          "file": "wsflow/server.py",
          "old": "if supplied_runtime and modules.builtin_active(WORK_CALENDAR):",
          "new": "if False:"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_package_generation.py",
        "-k",
        "test_legacy_handler_uses_supplied_runtime"
