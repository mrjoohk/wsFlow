      "name": "unsupported supplied runtime hook aborts core handler creation",
      "edits": [
        {
          "file": "wsflow/server.py",
          "old": "except Exception as exc:\n                modules.errors[WORK_CALENDAR] = 'supplied runtime failed: ' + str(exc)",
          "new": "except Exception:\n                raise",
          "func": "make_handler"
        }
      ],
      "test": [
