{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github"
  ],
  "test": [
    "node",
    "tests/i3_browser.cjs"
  ],
  "timeout": 180,
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "WSFLOW_BROWSER_OUTPUT": "{tmp}/browser-output"
  },
  "mutants": [
    {
      "id": "U01",
      "name": "Google edit control exposed",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "${e.origin==='google'?'<span class=\"muted\">Google 읽기 전용</span>'",
          "new": "${false?'<span class=\"muted\">Google 읽기 전용</span>'"
        }
      ]
    },
    {
      "id": "U02",
      "name": "event private body leaks into date cell",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": " ${esc(e.title)}</span>",
          "new": " ${esc(e.title)} ${esc(e.body)}</span>"
        }
      ]
    }
  ]
}
