    },
    {
      "edits": [
        {
          "file": "wsflow/modules/workspace_operations/gitops.py",
          "new": "def _outside_status(function):\n    def invoke(repo):\n        result = writer_function(function)(repo)\n        if callable(result.get('status')):\n            result['status'] = result['status']()\n        return result\n    return invoke\n\n\n@_outside_status\ndef pull_ff(",
          "old": "@_git_writer\ndef pull_ff("
        },
        {
          "file": "wsflow/modules/workspace_operations/gitops.py",
          "func": "pull_ff",
          "new": "'command': 'git ' + ' '.join(args), 'status': lambda: status(repo), 'sync': fetched['sync']",
          "old": "'command': 'git ' + ' '.join(args), 'status': status(repo), 'sync': fetched['sync']"
        }
      ],
      "id": "GT_PULL_FINAL_STATUS",
      "name": "pull root ends before final status",
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_git_writer.py",
        "-k",
        "test_pull_holds_final_status_after_real_ff"
