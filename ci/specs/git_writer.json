          "new": "cp = writer_function(run_git)(repo, 'fetch', '--all', check=False)",
          "old": "cp = run_git(repo, 'fetch', '--all', check=False)"
        }
      ],
      "id": "GT_FETCH_GIT_ONLY",
      "name": "fetch root ends before sync metadata",
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
