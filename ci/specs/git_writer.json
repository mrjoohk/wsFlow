{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github",
    "examples"
  ],
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONIOENCODING": "utf-8",
    "TEMP": "{tmp}",
    "TMP": "{tmp}",
    "TMPDIR": "{tmp}"
  },
  "mutants": [
    {
      "edits": [
        {
          "file": "wsflow/modules/workspace_operations/gitops.py",
          "new": "def fetch(",
          "old": "@_git_writer\ndef fetch("
        }
      ],
      "id": "GT_FETCH_ENTRY",
      "name": "fetch skips cooperative admission",
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_git_writer.py",
        "-k",
        "test_barrier_rejects_both_before_git_or_sync_effects"
      ]
    },
    {
      "edits": [
        {
          "file": "wsflow/modules/workspace_operations/gitops.py",
          "new": "def pull_ff(",
          "old": "@_git_writer\ndef pull_ff("
        }
      ],
      "id": "GT_PULL_ENTRY",
      "name": "pull skips cooperative admission",
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-p",
        "test_git_writer.py",
        "-k",
        "test_barrier_rejects_both_before_git_or_sync_effects"
