{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github"
  ],
  "test": [
    "node",
    "tests/i7_browser.cjs"
  ],
  "timeout": 180,
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "WSFLOW_BROWSER_OUTPUT": "{tmp}/browser-output"
  },
  "mutants": [
    {
      "id": "UI701",
      "name": "batch ignores unsaved draft",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "if(!await guardJiraUnsaved(p))return;\n    if(!box.isConnected)return;",
          "new": "if(false)return;\n    if(!box.isConnected)return;"
        }
      ]
    },
    {
      "id": "UI702",
      "name": "partial query warning omitted",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "if(v.complete===false || v.warnings?.length)",
          "new": "if(false)"
        }
      ]
    },
    {
      "id": "UI703",
      "name": "late date reply overwrites selected day",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "if(!box.isConnected||generation!==state.workflowGeneration)return;",
          "new": "if(!box.isConnected)return;"
        }
      ]
    },
    {
      "id": "UI704",
      "name": "untrusted project alias rendered as HTML",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "${esc(p.alias)}</b> · ${p.enabled?",
          "new": "${p.alias}</b> · ${p.enabled?"
        }
      ]
    },
    {
      "id": "UI705",
      "name": "late Git response binds wrong view",
      "edits": [
        {
          "file": "wsflow/modules/workspace_operations/ui.js",
          "old": "if(!body.isConnected||state.current!==p.id||state.tab!=='status')return;",
          "new": "if(false)return;"
        }
      ]
    },
    {
      "id": "UI706",
      "name": "successful create hides failed personal-list visibility",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "if(jiraVisible(p,J)&&r.visibility&&r.visibility.state!=='visible')",
          "new": "if(false)"
        }
      ]
    },
    {
      "id": "UI707",
      "name": "failed batch claims watermark commit",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "result.committed?result.watermark_out:'보존 · 전진하지 않음'",
          "new": "result.watermark_out||'commit 완료'"
        }
      ]
    },
    {
      "id": "UI708",
      "name": "unknown signal becomes zero",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "p.signals?.new??'?'",
          "new": "p.signals?.new??0"
        }
      ]
    },
    {
      "id": "UI709",
      "name": "corrupt receipt warning hidden",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "(r.warnings||[]).map(w=>",
          "new": "[].map(w=>"
        }
      ]
    }
  ]
}
