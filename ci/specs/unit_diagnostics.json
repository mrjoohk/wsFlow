          "new": "emit('ignored_start', test=test.id(), tests_run=self.testsRun)"
        }
      ],
      "test": [
        "python",
        "-B",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "ci/tests",
