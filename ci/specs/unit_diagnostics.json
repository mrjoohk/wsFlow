{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github",
    "examples"
  ],
  "test": [
    "python",
    "-B",
    "-X",
    "utf8",
    "-m",
    "unittest",
    "discover",
    "-s",
    "ci/tests",
    "-p",
    "test_unit_diagnostics.py",
    "-k",
    "test_failure_error_skip_and_subtest_counters_match_completed_evidence"
  ],
  "timeout": 90,
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TEMP": "{tmp}",
    "TMP": "{tmp}",
    "TMPDIR": "{tmp}"
  },
  "mutants": [
