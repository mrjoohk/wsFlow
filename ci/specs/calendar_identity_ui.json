{
  "copy": [
    "wsflow",
    "static",
    "tests",
    "vendor",
    "tools",
    "ci",
    ".github"
  ],
  "test": [
    "python",
    "-B",
    "-X",
    "utf8",
    "tests/calendar_identity_shortpath.py"
  ],
  "timeout": 150,
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "mutants": [
    {
      "id": "REBIND_CHECKBOX",
      "name": "REBIND_CHECKBOX",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "d.unavailable.filter(id=>state.projects.some(p=>p.id===id)).map",
          "new": "d.unavailable.filter(()=>false).map"
        }
      ]
    },
    {
      "id": "REBIND_REQUEST",
      "name": "REBIND_REQUEST",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "...(action==='update'&&d.rebind?.length?{rebind_project_ids:d.rebind}:{}),",
          "new": "...{},"
        }
      ]
    },
    {
      "id": "UNAVAILABLE_WARNING",
      "name": "UNAVAILABLE_WARNING",
      "edits": [
        {
          "file": "wsflow/modules/work_calendar/ui.js",
          "old": "if(unavailable.size)",
          "new": "if(false)"
        }
      ]
    },
    {
      "id": "FIXTURE_CANONICAL_TEMP",
      "name": "fixture fails to canonicalize short TEMP before profiles",
      "edits": [
        {
          "file": "tests/calendar_identity_fixture.py",
          "old": "home=Path(temp).resolve();root=home/'root'",
          "new": "home=Path(temp);root=home/'root'"
        }
      ]
    }
  ]
}
